{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmesh.local/schema/skill-v1.json",
  "title": "SkillMesh canonical skill manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "displayName", "description", "files", "targets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "maxLength": 60, "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "maxLength": 40, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "files"],
        "additionalProperties": false,
        "properties": {
          "match": { "$ref": "#/$defs/match" },
          "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
        }
      }
    },
    "runtimes": { "type": "array", "uniqueItems": true, "items": { "enum": ["node", "python", "powershell", "sh"] } },
    "targets": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "denied": { "type": "array", "items": { "$ref": "#/$defs/target" } }
      }
    },
    "activation": { "enum": ["live", "reload", "next-launch"] },
    "lifecycle": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["enabled", "deprecated", "removed"] },
        "removeAfter": { "type": "string", "format": "date-time" },
        "graceDays": { "type": "integer", "minimum": 0 },
        "message": { "type": "string" },
        "emergencyOverride": {
          "type": "object",
          "required": ["approvedBy", "reason", "approvedAt"],
          "additionalProperties": false,
          "properties": {
            "approvedBy": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "approvedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "smokeTests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["file-exists", "file-contains"] },
          "path": { "type": "string" },
          "contains": { "type": "string", "maxLength": 500 },
          "match": { "$ref": "#/$defs/match" }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["source"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "destination": { "type": "string" },
            "kind": { "enum": ["text", "binary"] },
            "executable": { "type": "boolean" }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": { "enum": ["codex", "claude-code", "claude-desktop"] },
        "os": { "enum": ["darwin", "windows"] },
        "profile": { "enum": ["default", "personal", "organization"] },
        "scope": { "enum": ["global", "project"] }
      }
    },
    "target": {
      "type": "object",
      "required": ["harness", "os", "scope"],
      "additionalProperties": false,
      "properties": {
        "harness": { "enum": ["codex", "claude-code", "claude-desktop"] },
        "os": { "enum": ["darwin", "windows"] },
        "profile": { "enum": ["default", "personal", "organization"] },
        "scope": { "enum": ["global", "project"] }
      }
    }
  }
}
