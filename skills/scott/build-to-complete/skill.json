{
  "schemaVersion": 1,
  "id": "scott/build-to-complete",
  "version": "2.1.0",
  "displayName": "Build To Complete",
  "description": "Use when asked to \"build this to completion\", \"build the plan to complete\", \"fix this bug end to end\", \"work the backlog\", \"work these issues\", or \"run this phase with review gates\" on any repo. Plans and splits work into mergeable units, runs tiered agents in isolated worktrees, gates each on adversarial review and the project's own tests, then integrates and reports.",
  "files": [
    "SKILL.md",
    "agents/openai.yaml",
    "references/crew-config.md",
    "references/tiering.md",
    { "source": "scripts/crew.mjs", "kind": "text", "executable": true },
    { "source": "scripts/lib.mjs", "kind": "text", "executable": false }
  ],
  "runtimes": ["node"],
  "targets": {
    "required": [
      { "harness": "codex", "os": "darwin", "profile": "default", "scope": "global" },
      { "harness": "codex", "os": "windows", "profile": "default", "scope": "global" },
      { "harness": "claude-code", "os": "darwin", "profile": "personal", "scope": "global" },
      { "harness": "claude-code", "os": "darwin", "profile": "organization", "scope": "global" },
      { "harness": "claude-code", "os": "windows", "profile": "personal", "scope": "global" },
      { "harness": "claude-code", "os": "windows", "profile": "organization", "scope": "global" },
      { "harness": "claude-desktop", "os": "darwin", "profile": "personal", "scope": "global" },
      { "harness": "claude-desktop", "os": "darwin", "profile": "organization", "scope": "global" },
      { "harness": "claude-desktop", "os": "windows", "profile": "personal", "scope": "global" },
      { "harness": "claude-desktop", "os": "windows", "profile": "organization", "scope": "global" }
    ]
  },
  "activation": "next-launch",
  "smokeTests": [
    { "type": "file-contains", "path": "SKILL.md", "contains": "# Build To Complete" },
    { "type": "file-contains", "path": "scripts/crew.mjs", "contains": "crew <command>" },
    { "type": "file-exists", "path": "scripts/lib.mjs" },
    { "type": "file-exists", "path": "references/crew-config.md" },
    { "type": "file-exists", "path": "references/tiering.md" }
  ]
}
