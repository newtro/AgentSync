{
  "schemaVersion": 1,
  "id": "scott/agentsync",
  "version": "1.0.1",
  "displayName": "AgentSync",
  "description": "Use when the user mentions AgentSync or SkillMesh, or asks to \"add a skill to AgentSync\", \"update/publish a shared skill\", \"sync my skills\", \"run a skill sync\", \"check sync status\", \"onboard this machine/endpoint\", \"remove/retire a skill\", or \"why didn't my skill update\". Covers editing, validating, versioning, publishing, syncing, and diagnosing skills across Codex and Claude.",
  "files": ["SKILL.md", "references/operations.md"],
  "targets": {
    "required": [
      { "harness": "codex", "os": "darwin", "profile": "default", "scope": "global" },
      { "harness": "codex", "os": "windows", "profile": "default", "scope": "global" },
      { "harness": "claude-code", "os": "darwin", "profile": "personal", "scope": "global" },
      { "harness": "claude-code", "os": "darwin", "profile": "organization", "scope": "global" },
      { "harness": "claude-code", "os": "windows", "profile": "personal", "scope": "global" },
      { "harness": "claude-code", "os": "windows", "profile": "organization", "scope": "global" },
      { "harness": "claude-desktop", "os": "darwin", "profile": "personal", "scope": "global" },
      { "harness": "claude-desktop", "os": "darwin", "profile": "organization", "scope": "global" },
      { "harness": "claude-desktop", "os": "windows", "profile": "personal", "scope": "global" },
      { "harness": "claude-desktop", "os": "windows", "profile": "organization", "scope": "global" }
    ]
  },
  "activation": "next-launch",
  "smokeTests": [
    { "type": "file-contains", "path": "SKILL.md", "contains": "# AgentSync" },
    { "type": "file-exists", "path": "references/operations.md" }
  ]
}
