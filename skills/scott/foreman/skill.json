{
  "schemaVersion": 1,
  "id": "scott/foreman",
  "version": "2.0.0",
  "displayName": "Foreman",
  "description": "Send tasks to Scott's Foreman coordinating agent and manage correlated callbacks.",
  "files": [
    "SKILL.md",
    "agents/openai.yaml"
  ],
  "overlays": [
    {
      "match": {
        "harness": "codex"
      },
      "files": [
        {
          "source": "scripts/foreman.py",
          "executable": true
        },
        {
          "source": "tests/test_foreman.py",
          "executable": false
        }
      ]
    },
    {
      "match": {
        "harness": "claude-code"
      },
      "files": [
        {
          "source": "variants/claude/SKILL.md",
          "destination": "SKILL.md"
        },
        {
          "source": "variants/claude/foreman.py",
          "destination": "foreman.py",
          "executable": true
        },
        {
          "source": "variants/claude/selftest.py",
          "destination": "selftest.py",
          "executable": true
        }
      ]
    },
    {
      "match": {
        "harness": "claude-desktop"
      },
      "files": [
        {
          "source": "variants/claude/SKILL.md",
          "destination": "SKILL.md"
        },
        {
          "source": "variants/claude/foreman.py",
          "destination": "foreman.py",
          "executable": true
        },
        {
          "source": "variants/claude/selftest.py",
          "destination": "selftest.py",
          "executable": true
        }
      ]
    }
  ],
  "runtimes": [
    "python"
  ],
  "targets": {
    "required": [
      {
        "harness": "codex",
        "os": "darwin",
        "profile": "default",
        "scope": "global"
      },
      {
        "harness": "codex",
        "os": "windows",
        "profile": "default",
        "scope": "global"
      },
      {
        "harness": "claude-code",
        "os": "darwin",
        "profile": "personal",
        "scope": "global"
      },
      {
        "harness": "claude-code",
        "os": "darwin",
        "profile": "organization",
        "scope": "global"
      },
      {
        "harness": "claude-code",
        "os": "windows",
        "profile": "personal",
        "scope": "global"
      },
      {
        "harness": "claude-code",
        "os": "windows",
        "profile": "organization",
        "scope": "global"
      },
      {
        "harness": "claude-desktop",
        "os": "darwin",
        "profile": "personal",
        "scope": "global"
      },
      {
        "harness": "claude-desktop",
        "os": "darwin",
        "profile": "organization",
        "scope": "global"
      },
      {
        "harness": "claude-desktop",
        "os": "windows",
        "profile": "personal",
        "scope": "global"
      },
      {
        "harness": "claude-desktop",
        "os": "windows",
        "profile": "organization",
        "scope": "global"
      }
    ]
  },
  "activation": "next-launch",
  "smokeTests": [
    {
      "type": "file-contains",
      "path": "SKILL.md",
      "contains": "# Foreman"
    },
    {
      "match": {
        "harness": "codex"
      },
      "type": "file-exists",
      "path": "scripts/foreman.py"
    },
    {
      "match": {
        "harness": "codex"
      },
      "type": "file-contains",
      "path": "scripts/foreman.py",
      "contains": "_ngrok_public_url"
    },
    {
      "match": {
        "harness": "claude-code"
      },
      "type": "file-contains",
      "path": "foreman.py",
      "contains": "def cmd_sink"
    },
    {
      "match": {
        "harness": "claude-code"
      },
      "type": "file-exists",
      "path": "selftest.py"
    },
    {
      "match": {
        "harness": "claude-desktop"
      },
      "type": "file-contains",
      "path": "foreman.py",
      "contains": "def cmd_sink"
    },
    {
      "match": {
        "harness": "claude-desktop"
      },
      "type": "file-exists",
      "path": "selftest.py"
    }
  ]
}
